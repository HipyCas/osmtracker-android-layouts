            <button type="tag" label="···  Minimum speed 90  ···" icon="maxspeed_extended_icons/minimum_90.png"/>
        </row>
    </layout>

    <layout name="road_signs">
        <row>
            <button type="page" label="Home" targetlayout="root"/>
            <button type="page" label="Max speed" targetlayout="max_limits"/>
            <button type="page" label="Recommended" targetlayout="recommended_limits"/>
        </row>
        <row>
            <button type="tag" label="···  Stop  ···" icon="maxspeed_extended_icons/stop.png"/>
            <button type="tag" label="···  Give way  ···" icon="maxspeed_extended_icons/give_way.png"/>
            <button type="tag" label="···  Static radar  ···" icon="maxspeed_extended_icons/static_radar.png"/>
