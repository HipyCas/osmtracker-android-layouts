<layouts>
    <layout name="root">
        <row>
            <button type="textnote" icon="logo_textnote"/>
        </row>
        <row>
            <button type="page" label="Max speed" targetlayout="max_limits"/>
            <button type="page" label="Recommended" targetlayout="recommended_limits"/>
            <button type="page" label="Minimum" targetlayout="minimum_limits"/>
        </row>
        <row>
            <button type="page" label="Road signs" targetlayout="road_signs"/>
        </row>
    </layout>

    <layout name="max_limits">
        <row>
            <button type="page" label="Home" targetlayout="root"/>
            <button type="page" label="Recommended" targetlayout="recommended_limits"/>
            <button type="page" label="Minimum" targetlayout="minimum_limits"/>
        </row>
        <row>
            <button type="tag" label="···  Maxspeed 30  ···" icon="maxspeed_icons/30.png"/>
            <button type="tag" label="···  Maxspeed 40  ···" icon="maxspeed_icons/40.png"/>
            <button type="tag" label="···  Maxspeed 50  ···" icon="maxspeed_icons/50.png"/>
        </row>
        <row>
            <button type="tag" label="···  Maxspeed 60  ···" icon="maxspeed_icons/60.png"/>
            <button type="tag" label="···  Maxspeed 70  ···" icon="maxspeed_icons/70.png"/>
            <button type="tag" label="···  Maxspeed 80  ···" icon="maxspeed_icons/80.png"/>
        </row>
        <row>
            <button type="tag" label="···  Maxspeed 90  ···" icon="maxspeed_icons/90.png"/>
            <button type="tag" label="···  Maxspeed 100  ···" icon="maxspeed_icons/100.png"/>
            <button type="tag" label="···  Maxspeed 120  ···" icon="maxspeed_icons/120.png"/>
        </row>
        <row>
            <button type="tag" label="···  Maxspeed End  ···" icon="maxspeed_icons/end.png"/>
        </row>
    </layout>

    <layout name="recommended_limits">
        <row>
            <button type="page" label="Home" targetlayout="root"/>
            <button type="page" label="Max speed" targetlayout="max_limits"/>
            <button type="page" label="Road signs" targetlayout="road_signs"/>
        </row>
        <row>
            <button type="tag" label="···  Recommended 30  ···" icon="maxspeed_extended_icons/recommended_30.png"/>
            <button type="tag" label="···  Recommended 40  ···" icon="maxspeed_extended_icons/recommended_40.png"/>
            <button type="tag" label="···  Recommended 50  ···" icon="maxspeed_extended_icons/recommended_50.png"/>
        </row>
        <row>
            <button type="tag" label="···  Recommended 60  ···" icon="maxspeed_extended_icons/recommended_60.png"/>
            <button type="tag" label="···  Recommended 70  ···" icon="maxspeed_extended_icons/recommended_70.png"/>
            <button type="tag" label="···  Recommended 80  ···" icon="maxspeed_extended_icons/recommended_80.png"/>
        </row>
        <row>
            <button type="tag" label="···  Recommended 90  ···" icon="maxspeed_extended_icons/recommended_90.png"/>
            <button type="tag" label="···  Recommended 100  ···" icon="maxspeed_extended_icons/recommended_100.png"/>
            <button type="tag" label="···  Recommended 120  ···" icon="maxspeed_extended_icons/recommended_120.png"/>
        </row>
    </layout>

    <layout name="minimum_limits">
        <row>
            <button type="page" label="Home" targetlayout="root"/>
            <button type="page" label="Max speed" targetlayout="max_limits"/>
            <button type="page" label="Road signs" targetlayout="road_signs"/>
        </row>
        <row>
            <button type="tag" label="···  Minimum speed 10  ···" icon="maxspeed_extended_icons/minimum_10.png"/>
            <button type="tag" label="···  Minimum speed 20  ···" icon="maxspeed_extended_icons/minimum_20.png"/>
            <button type="tag" label="···  Minimum speed 30  ···" icon="maxspeed_extended_icons/minimum_30.png"/>
        </row>
        <row>
            <button type="tag" label="···  Minimum speed 40  ···" icon="maxspeed_extended_icons/minimum_40.png"/>
            <button type="tag" label="···  Minimum speed 50  ···" icon="maxspeed_extended_icons/minimum_50.png"/>
            <button type="tag" label="···  Minimum speed 60  ···" icon="maxspeed_extended_icons/minimum_60.png"/>
